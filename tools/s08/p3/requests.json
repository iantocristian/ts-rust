{
  "version": 1,
  "scope": "Named S08 P3a source unions, properties and primitive assignments; no full P3/S08 acceptance claim",
  "options": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "noLib": true
  },
  "programs": [
    {
      "id": "union-reduction",
      "files": {
        "/case.ts": "type U = string | number | null; type V = number | string | null; type Lit = \"b\" | \"a\" | \"b\"; type Wide = string | \"a\"; type Bool = false | true; type Gone = never | string; type Top = unknown | number;\n"
      },
      "roots": [
        "/case.ts"
      ],
      "queries": [
        {
          "id": "U",
          "file": "/case.ts",
          "declaration": "U",
          "target": "name",
          "operation": "declared_type"
        },
        {
          "id": "V",
          "file": "/case.ts",
          "declaration": "V",
          "target": "name",
          "operation": "declared_type"
        },
        {
          "id": "Lit",
