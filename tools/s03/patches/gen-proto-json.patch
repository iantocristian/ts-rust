+package main
+
+// This adapter observes gen-proto's resolved methods and type renderer. It does
+// not reinterpret dispatch, annotations, tags, or the renderer's special cases.
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"go/types"
+	"os"
+	"path/filepath"
+	"slices"
+	"sort"
+	"strings"
+)
+
+type wireType struct {
+	TypeScript string     `json:"typescript"`
+	Go         *typeShape `json:"go,omitempty"`
+}
+
+// Named references stop recursion. Their resolved client surface is exported
+// separately; private server fields must never pull the compiler graph into it.
+type typeShape struct {
+	Kind    string     `json:"kind"`
+	Name    string     `json:"name,omitempty"`
+	Element *typeShape `json:"element,omitempty"`
+	Key     *typeShape `json:"key,omitempty"`
+	Length  *int64     `json:"length,omitempty"`
+}
+
+type methodExport struct {
+	Constant       string   `json:"constant"`
+	ID             string   `json:"id"`
+	Params         wireType `json:"params"`
+	Result         wireType `json:"result"`
+	ResultNullable bool     `json:"resultNullable"`
+}
+
+type fieldExport struct {
+	GoName        string     `json:"goName"`
+	JSONName      string     `json:"jsonName"`
+	Go            *typeShape `json:"go"`
+	TypeScript    string     `json:"typescript,omitempty"`
+	Doc           string     `json:"typescriptDoc"`
+	Tag           string     `json:"tag"`
+	ClientVisible bool       `json:"clientVisible"`
+	Optional      bool       `json:"optional"`
+	NonNil        bool       `json:"nonnil"`
+	Deprecated    bool       `json:"deprecated"`
+	Internal      bool       `json:"internal"`
+}
+
+type namedExport struct {
+	ID           string        `json:"id"`
+	TypeScript   string        `json:"typescript"`
+	Kind         string        `json:"kind"`
+	Doc          string        `json:"typescriptDoc"`
+	Fields       []fieldExport `json:"fields,omitempty"`
+	Underlying   *typeShape    `json:"underlying,omitempty"`
+	CodecMethods []string      `json:"codecMethods,omitempty"`
+}
+
+type aliasExport struct {
+	Name       string `json:"name"`
+	TypeScript string `json:"typescript"`
+	Doc        string `json:"typescriptDoc"`
+}
+
+func renderedDoc(indent, doc string) string {
+	var out bytes.Buffer
+	writeDoc(&out, indent, doc)
+	return out.String()
+}
+
+type importExport struct {
+	Path  string   `json:"path"`
+	Names []string `json:"names"`
+}
+
+type apiExport struct {
+	SchemaVersion    int            `json:"schemaVersion"`
+	Generator        string         `json:"generator"`
+	Methods          []methodExport `json:"methods"`
+	Types            []namedExport  `json:"types"`
+	Imports          []importExport `json:"imports"`
+	SpecialMappings  []namedExport  `json:"specialMappings"`
+	DeclarationOrder []string       `json:"declarationOrder"`
+	Aliases          []aliasExport  `json:"aliases"`
+}
+
+func qualifiedType(t types.Type) string {
+	return types.TypeString(t, func(pkg *types.Package) string { return pkg.Path() })
+}
+
+func shape(t types.Type) *typeShape {
+	if t == nil {
+		return nil
+	}
+	t = types.Unalias(t)
+	switch t := t.(type) {
+	case *types.Named:
+		return &typeShape{Kind: "named", Name: qualifiedType(t)}
+	case *types.Basic:
+		return &typeShape{Kind: "basic", Name: t.Name()}
+	case *types.Pointer:
+		return &typeShape{Kind: "pointer", Element: shape(t.Elem())}
+	case *types.Slice:
+		return &typeShape{Kind: "slice", Element: shape(t.Elem())}
+	case *types.Array:
+		length := t.Len()
+		return &typeShape{Kind: "array", Element: shape(t.Elem()), Length: &length}
+	case *types.Map:
+		return &typeShape{Kind: "map", Key: shape(t.Key()), Element: shape(t.Elem())}
+	case *types.Interface:
+		return &typeShape{Kind: "interface", Name: qualifiedType(t)}
+	default:
+		return &typeShape{Kind: "opaque", Name: qualifiedType(t)}
+	}
+}
+
+func codecMethods(named *types.Named) []string {
+	var methods []string
+	methodSet := types.NewMethodSet(types.NewPointer(named))
+	for i := range methodSet.Len() {
+		name := methodSet.At(i).Obj().Name()
+		if slices.Contains([]string{"MarshalJSON", "MarshalJSONTo", "UnmarshalJSON", "UnmarshalJSONFrom", "MarshalText", "UnmarshalText"}, name) {
+			methods = append(methods, name)
+		}
+	}
+	sort.Strings(methods)
+	return methods
+}
+
+func (r *typeRenderer) exportJSON(methods []*methodInfo, outputPath string) error {
+	out := apiExport{SchemaVersion: 1, Generator: "tools/gen-proto", Imports: []importExport{}, SpecialMappings: []namedExport{}, DeclarationOrder: r.exportDeclarations, Aliases: r.exportAliases}
+	for _, method := range methods {
+		params, result := method.paramsText, method.resultText
+		if params == "" {
+			params = r.requestType(method.params)
+		}
+		if result == "" {
+			result = r.resultType(method.result, method.resultNullable)
+		}
+		out.Methods = append(out.Methods, methodExport{method.constantName, method.name, wireType{params, shape(method.params)}, wireType{result, shape(method.result)}, method.resultNullable})
+	}
+	// declarations() has already visited every visible field. Snapshot before
+	// inspecting fields so map iteration cannot affect export order.
+	namedTypes := make([]*types.Named, 0, len(r.exportTypes))
+	for named := range r.exportTypes {
+		namedTypes = append(namedTypes, named)
+	}
+	sort.Slice(namedTypes, func(i, j int) bool { return qualifiedType(namedTypes[i]) < qualifiedType(namedTypes[j]) })
+	for _, named := range namedTypes {
+		wire := r.exportTypes[named]
+		item := namedExport{ID: qualifiedType(named), TypeScript: wire, Kind: "mapping", CodecMethods: codecMethods(named), Doc: renderedDoc("", r.docs[named.Obj()])}
+		if st, ok := named.Underlying().(*types.Struct); ok && r.names[wire] == named.Obj() {
+			item.Kind = "dto"
+			for i := range st.NumFields() {
+				name, include, optional, nonnil, deprecated, internal := jsonField(st, i)
+				visible := include && !deprecated && !internal
+				fieldType := ""
+				if visible {
+					fieldType = r.typeString(st.Field(i).Type(), !optional && !nonnil)
+					if strings.HasSuffix(named.Obj().Name(), "Params") && isArrayType(st.Field(i).Type()) {
+						fieldType = "readonly " + fieldType
+					}
+				}
+				item.Fields = append(item.Fields, fieldExport{st.Field(i).Name(), name, shape(st.Field(i).Type()), fieldType, renderedDoc("    ", r.docs[st.Field(i)]), st.Tag(i), visible, optional, nonnil, deprecated, internal})
+			}
+		} else if basic, ok := named.Underlying().(*types.Basic); ok && basicType(basic) == wire {
+			item.Kind = "scalar"
+			item.Underlying = shape(basic)
+		}
+		out.Types = append(out.Types, item)
+		if item.Kind == "mapping" || len(item.CodecMethods) != 0 {
+			// Deliberately include custom codecs on ordinary-looking DTOs, such as
+			// BatchRequestsResponse. Tags alone do not define their serializer.
+			out.SpecialMappings = append(out.SpecialMappings, namedExport{ID: item.ID, TypeScript: item.TypeScript, Kind: item.Kind, CodecMethods: item.CodecMethods})
+		}
+	}
+	for path, names := range r.imports {
+		out.Imports = append(out.Imports, importExport{path, slices.Clone(names)})
+	}
+	sort.Slice(out.Imports, func(i, j int) bool { return out.Imports[i].Path < out.Imports[j].Path })
+	for i := range out.Imports {
+		sort.Strings(out.Imports[i].Names)
+	}
+	data, err := json.MarshalIndent(out, "", "  ")
+	if err != nil {
+		return fmt.Errorf("encode API export: %w", err)
+	}
+	if err := os.MkdirAll(filepath.Dir(outputPath), 0o755); err != nil {
+		return err
+	}
+	if err := os.WriteFile(outputPath, append(data, '\n'), 0o644); err != nil {
+		return fmt.Errorf("write API export: %w", err)
+	}
+	return nil
+}
