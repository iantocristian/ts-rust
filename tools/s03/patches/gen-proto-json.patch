+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestJSONExportPreservesRendererContract(t *testing.T) {
+	input := filepath.Join("..", "..", "tsc", "internal", "api", "proto.go")
+	dir := t.TempDir()
+	plain, exported, contract := filepath.Join(dir, "plain.ts"), filepath.Join(dir, "exported.ts"), filepath.Join(dir, "api.json")
+	if err := generate(input, plain); err != nil {
+		t.Fatal(err)
+	}
+	if err := generateWithExport(input, exported, contract); err != nil {
+		t.Fatal(err)
+	}
+	first, err := os.ReadFile(plain)
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := os.ReadFile(exported)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(first, second) {
+		t.Fatal("enabling JSON export changed TypeScript output")
+	}
+	data, err := os.ReadFile(contract)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var api apiExport
+	if err := json.Unmarshal(data, &api); err != nil {
+		t.Fatal(err)
+	}
+	methods := make(map[string]methodExport)
+	for _, method := range api.Methods {
+		if _, duplicate := methods[method.ID]; duplicate {
+			t.Fatalf("duplicate method %s", method.ID)
+		}
+		methods[method.ID] = method
+	}
+	if method := methods["release"]; method.Constant != "MethodRelease" || method.Result.TypeScript != "void" {
+		t.Fatalf("release acknowledgement leaked into export: %+v", method)
+	}
+	if method := methods["getSourceFile"]; method.Result.TypeScript != "SourceFileResponse | null" || !method.ResultNullable {
+		t.Fatalf("result override or nullable annotation lost: %+v", method)
+	}
+	const apiPath = "github.com/microsoft/TypeScript/tsc/internal/api."
+	typeByID := make(map[string]namedExport)
+	for _, item := range api.Types {
+		typeByID[item.ID] = item
+	}
+	var foundOpenProjects bool
+	for _, field := range typeByID[apiPath+"UpdateSnapshotParams"].Fields {
+		if field.JSONName == "openProjects" {
+			foundOpenProjects = field.Optional && field.ClientVisible && field.TypeScript == "readonly DocumentIdentifier[]" && field.Tag == `json:"openProjects,omitempty"`
+		}
+	}
+	if !foundOpenProjects {
+		t.Fatal("request array omission/readonly metadata missing")
+	}
+	var foundNonNil bool
+	for _, field := range typeByID[apiPath+"BatchRequestsResponse"].Fields {
+		if field.JSONName == "responses" {
+			foundNonNil = field.NonNil && !field.Optional && field.TypeScript == "BatchResponse[]"
+		}
+	}
+	if !foundNonNil {
+		t.Fatal("nonnil response array metadata missing")
+	}
+	specials := make(map[string]namedExport)
+	for _, item := range api.SpecialMappings {
+		specials[item.ID] = item
+	}
+	if len(specials[apiPath+"DocumentIdentifier"].CodecMethods) == 0 || len(specials[apiPath+"BatchRequestsResponse"].CodecMethods) == 0 {
+		t.Fatal("custom serializer inventory incomplete")
+	}
+	if specials["github.com/microsoft/TypeScript/tsc/internal/core.Tristate"].TypeScript != "boolean" {
+		t.Fatal("special tristate mapping lost")
+	}
+	if err := generateWithExport(input, exported, contract); err != nil {
+		t.Fatal(err)
+	}
+	repeated, err := os.ReadFile(contract)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(data, repeated) {
+		t.Fatal("JSON export is not deterministic")
+	}
+}
